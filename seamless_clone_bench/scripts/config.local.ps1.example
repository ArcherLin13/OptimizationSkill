# Copy to config.local.ps1 and edit paths for this machine.
# config.local.ps1 is gitignored.

# DevEco OpenHarmony NDK root (must contain build/cmake/ohos.toolchain.cmake)
$OHOS_NATIVE = "C:\Program Files\Huawei\DevEco Studio\sdk\default\openharmony\native"

# Optional: override OpenCV folder (default: ../opencv)
# $OPENCV_ROOT = "D:\libs\opencv"

# Optional: device OpenCV on phone
# $DEVICE_LIB_DIR = "/chip_prod/lib64"

# Optional: hdc push/run directory on device
# $REMOTE_DIR = "/data/vendor/camera"
